flowchart LR
  nr["terraform/network<br/>Backend assumes the state role<br/>Network resources use the provider"]:::neutral
  role["eks-lab-terraform-state<br/>Trusts the OpsBox role<br/>State: Get / Put; lock: Get / Put / Delete"]:::identity
  ns["Network state in S3<br/>network/terraform.tfstate<br/>network/terraform.tfstate.tflock"]:::data
  np["AWS provider on OpsBox<br/>Used by terraform/network<br/>AdministratorAccess remains"]:::identity
  net["14 imported network resources<br/>VPC, four subnets, internet gateway, three route tables,<br/>public default route, and four subnet associations."]:::network
  br["terraform/bootstrap<br/>AWS provider uses OpsBox role<br/>Imports preserve existing settings"]:::neutral
  boot["Nine imported bootstrap resources<br/>Bucket + five S3 configuration resources;<br/>network-backend IAM role, policy, and their attachment."]:::data
  bb["Bootstrap backend<br/>Uses OpsBox credentials directly<br/>Local state migrated to S3"]:::identity
  bs["Bootstrap state in the same S3 bucket<br/>bootstrap/terraform.tfstate<br/>bootstrap/terraform.tfstate.tflock"]:::data
